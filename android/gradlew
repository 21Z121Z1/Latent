#!/bin/sh
# Pinned, checksum-verified Gradle bootstrap. No globally installed Gradle is used.
set -eu
version=8.13
checksum=20f1b1176237254a6fc204d8434196fa11a4cfb387567519c61556e8710aed78
cache="${GRADLE_USER_HOME:-$HOME/.gradle}/latent-distributions"
install="$cache/gradle-$version"
if [ ! -x "$install/bin/gradle" ]; then
    mkdir -p "$cache"
    temp=$(mktemp -d "$cache/bootstrap.XXXXXXXX")
    trap 'rm -rf "$temp"' EXIT HUP INT TERM
    curl --fail --location --proto '=https' --tlsv1.2 --retry 3 \
        "https://services.gradle.org/distributions/gradle-$version-bin.zip" -o "$temp/gradle.zip"
    if command -v sha256sum >/dev/null 2>&1; then
        actual=$(sha256sum "$temp/gradle.zip" | cut -d ' ' -f 1)
    else
        actual=$(shasum -a 256 "$temp/gradle.zip" | cut -d ' ' -f 1)
    fi
    [ "$actual" = "$checksum" ] || { echo 'Gradle distribution checksum mismatch' >&2; exit 1; }
    unzip -q "$temp/gradle.zip" -d "$temp"
    if [ ! -d "$install" ]; then mv "$temp/gradle-$version" "$install"; fi
fi
exec "$install/bin/gradle" "$@"
